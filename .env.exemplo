PEXELS_API_KEY=cole_sua_chave_aqui
VELOCIDADE_VOZ=+8%
# A voz da narração segue a língua do canal (dados/canal.json, campo "voz").
# VOZ aqui só é usada se o canal não tiver voz definida.
# Vozes: pt-BR-FranciscaNeural, pt-BR-AntonioNeural, en-US-JennyNeural, en-US-GuyNeural, es-MX-DaliaNeural, es-MX-JorgeNeural
VOZ=pt-BR-FranciscaNeural
# Opcional: modelo que o painel usa ao pedir ideias/roteiros ao Claude Code (sonnet ou opus)
CLAUDE_MODELO=sonnet
