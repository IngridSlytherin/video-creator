!dados/temas/animais.json
historico.json
roteiros/*.json

# músicas: baixe as suas (ex.: Biblioteca de áudio do YouTube); não podem ser redistribuídas
public/musica/*.mp3

# configuração local do Claude Code e skills de terceiros (instale com o comando do README)
.claude/launch.json
.claude/settings.local.json
.claude/skills/remotion-*/
